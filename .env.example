# Copy to .env.local for local development. Values below target the
# local backend started by `npx convex dev`.
# NEVER put secrets in this file: server keys live in the deployment
# (`npx convex env set NAME=value`) and never reach git (.env* is ignored).

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=anonymous:anonymous-insight-flow

# Local backend (Convex client). Required by the app to connect.
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210

# Local site URL (OAuth callbacks, served JWKS). Convention; informational.
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211

# --- Deployment env (set with `npx convex env set`, NOT here) ---
# JWT_PRIVATE_KEY  - RS256 signing key (set)
# JWKS             - public keys for verification (set)
# SITE_URL         - app origin for post-login redirects, e.g. http://localhost:3000 (set)
# DEMO_ENABLED     - "true" enables the dev-only demo workspace claim (set)
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET - from Google Cloud Console (missing)
