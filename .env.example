# Copy to .env.local for local development. Values below target the
# local backend started by `npx convex dev`.
# NEVER put secrets in this file: server keys live in the deployment
# (`npx convex env set NAME=value`) and never reach git (.env* is ignored).

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=anonymous:anonymous-insight-flow

# Local backend (Convex client). Required by the app to connect.
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210

# Convex HTTP actions origin (OAuth callbacks, attachment links, uploads).
# The CSP in proxy.ts is built from it: in production it must equal the
# deployment's CONVEX_SITE_URL origin (set it explicitly with a custom domain).
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211

# --- Deployment env (set with `npx convex env set`, NOT here) ---
# JWT_PRIVATE_KEY  - RS256 signing key (set)
# JWKS             - valid JSON public keys matching JWT_PRIVATE_KEY.
#                    On PowerShell, set with `npx convex env set JWKS --from-file jwks.json`
#                    so shell quoting cannot remove the JSON quotes.
# SITE_URL         - app origin for post-login redirects, e.g. http://localhost:3000 (set)
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET - from Google Cloud Console (required for Google sign-in)

# --- Error tracking (Sentry, Next.js app). Optional: leave unset to disable. ---
# Public DSN of the Sentry project. When unset, Sentry is a no-op and the
# build does not load the Sentry plugin.
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org-id>.ingest.sentry.io/<project-id>
# Build-time only (hosting env / CI secrets, never commit): source map upload
# runs only when SENTRY_AUTH_TOKEN is set.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# Optional environment tag overrides (default: VERCEL_ENV / NEXT_PUBLIC_VERCEL_ENV,
# then NODE_ENV): SENTRY_ENVIRONMENT (server), NEXT_PUBLIC_SENTRY_ENVIRONMENT (browser).
# SENTRY_ENVIRONMENT=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# --- Abuse protection (Cloudflare Turnstile) ---
# Protects the public intake form (/f/<slug>) and the auth flows that email a
# code (sign-up, resend code, password reset).
# Public site key for the widget. When unset no widget renders.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Deployment env (set with `npx convex env set`, NOT here):
# TURNSTILE_SECRET_KEY    - Turnstile secret, verified server-side. Without it
#                           every public submission and auth code request is
#                           rejected (fails closed).
# INTAKE_CAPTCHA_DISABLED - set to exactly "true" ONLY on local/dev deployments
#                           to skip the check (intake AND auth) without
#                           TURNSTILE_SECRET_KEY.

# --- Auth email + notifications (deployment env, `npx convex env set`, NOT here) ---
# Password sign-up/sign-in verify the email with an 8-digit code, "Forgot
# password?" resets with a code, and email changes are confirmed by a code
# sent to the new address. Projects can also send critical alerts and a
# weekly digest. All of it goes through Brevo's transactional API.
# BREVO_API_KEY    - Brevo API key (SMTP & API -> API Keys). Required in production:
#                    without it auth codes cannot be sent (sign-up/reset show an
#                    error) and notifications are skipped with an error in the log.
# EMAIL_FROM       - sender verified in Brevo (Senders & IPs -> Senders), e.g.
#                    "InsightFlow <you@gmail.com>". No domain needed. Required.
# SITE_URL         - (see above) also the base of every link in emails, e.g.
#                    https://app.yourdomain.com/projects/<slug>/feedback?feedback=<id>
# EMAIL_DEV_LOG    - set to exactly "true" ONLY on local/dev deployments: emails and
#                    auth codes are printed to the Convex logs (`npx convex logs`)
#                    instead of being sent. No Brevo account needed.
# OPS_ALERT_EMAIL  - where backend failure alerts go (failed background jobs,
#                    unfinished purges). Recommended in production.
# BREVO_WEBHOOK_SECRET - optional. Long random string; point a Brevo webhook at
#                    https://<deployment>.convex.site/brevo-webhook?token=<secret>
#                    to record hard bounces/complaints so notification emails skip them.
